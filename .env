# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Email / SMTP Configuration for Direct Admin Replies
# Option 1: Gmail (Use a Google App Password from https://myaccount.google.com/apppasswords)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM=your-email@gmail.com

# Option 2: Custom SMTP (SendGrid, Mailgun, AWS SES, Brevo, Outlook, etc.)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=your-smtp-user
# EMAIL_PASS=your-smtp-password
# EMAIL_SECURE=false

